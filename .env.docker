# ============================================================
#  متغیرهای محیطی مخصوص اجرای LOCAL با Docker Compose
#  استفاده: cp .env.docker .env
#  (در حالت `docker compose up` همین مقدارها داخل سرویس‌ها set شده‌اند)
# ============================================================

# --- دیتابیس (PostgreSQL — کانتینر سرویس postgres) ---
DATABASE_URL=postgresql://app:app_password@127.0.0.1:5432/app_db

# --- احراز هویت (سشن امضاشده با HMAC) ---
# برای محیط واقعی مقدار بلند و تصادفی بگذارید: openssl rand -hex 32
AUTH_SECRET=dev-only-secret-change-me-in-production-please

# --- سئو / آدرس عمومی ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- درگاه پرداخت (حالت شبیه‌سازی‌شده) ---
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=true
