.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ============================================
#   تصاویر آپلودشده توسط کاربران (User uploads)
#   پوشه خالی با .gitkeep در گیت نگه‌داشته می‌شود
# ============================================
public/uploads/*
!public/uploads/.gitkeep

# ============================================
#   لاگ‌ها و فایل‌های موقت
# ============================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

