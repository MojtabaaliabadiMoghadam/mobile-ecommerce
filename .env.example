# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Auth ---
# Secret used to sign session cookies (HMAC). Use a long random string in production.
AUTH_SECRET=change-me-to-a-long-random-string

# --- SEO / URLs ---
# Public base URL used for canonical links, Open Graph, sitemap.xml and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payment (ZarinPal) ---
# The demo runs a simulated (sandbox) gateway; set these when wiring the real API.
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=true
